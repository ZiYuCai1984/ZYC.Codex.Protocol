<Project>

  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>_</DependentUpon>
    </Compile>
  </ItemGroup>

  <PropertyGroup>
    <EnableFody Condition="'$(EnableFody)' == ''">false</EnableFody>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableFody)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)FodyWeavers.xml"
          Link="FodyWeavers.xml" />
    <PackageReference Include="PropertyChanged.Fody" />
  </ItemGroup>

  <PropertyGroup>
    <V_ZYC_CoreToolkit>4.0.5</V_ZYC_CoreToolkit>
    <V_ZYC_CoreToolkit_Extensions_Fxc>3.8.4</V_ZYC_CoreToolkit_Extensions_Fxc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Update="ZYC.CoreToolkit" Version="$(V_ZYC_CoreToolkit)" />
    <PackageReference Update="ZYC.CoreToolkit.Pro" Version="$(V_ZYC_CoreToolkit)" />
    <PackageReference Update="ZYC.CoreToolkit.Abstractions" Version="$(V_ZYC_CoreToolkit)" />
    <PackageReference Update="ZYC.CoreToolkit.Extensions.Autofac" Version="$(V_ZYC_CoreToolkit)" />
    <PackageReference Update="ZYC.CoreToolkit.Extensions.Settings" Version="$(V_ZYC_CoreToolkit)" />
    <PackageReference Update="ZYC.CoreToolkit.Extensions.WebView2" Version="$(V_ZYC_CoreToolkit)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ZYC.CoreToolkit.Extensions.Fxc" Version="$(V_ZYC_CoreToolkit_Extensions_Fxc)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="ZYC.CoreToolkit.CodeGenerator" Version="$(V_ZYC_CoreToolkit)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime;build;native;contentfiles;analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="NJsonSchema" Version="11.6.1" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Update="coverlet.collector" Version="6.0.4" />
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Update="xunit" Version="2.9.3" />
    <PackageReference Update="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Update="System.Reactive" Version="7.0.0-preview.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="PropertyChanged.Fody" Version="4.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>


  <ItemGroup>
    <PackageReference Update="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
